{
  "name": "@crimson-crawler/crimson-crawler-client",
  "version": "4.0.0",
  "description": "Typed TypeScript client for the Crimson Crawler API",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimson-crawler/typescript-sdk.git"
  },
  "homepage": "https://crimsoncrawler.com/docs/clients/typescript-client/",
  "bugs": {
    "url": "https://github.com/crimson-crawler/typescript-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./_generated": {
      "types": "./dist/_generated/index.d.ts",
      "import": "./dist/_generated/index.js",
      "require": "./dist/_generated/index.cjs"
    },
    "./_generated/sdk.gen": {
      "types": "./dist/_generated/sdk.gen.d.ts",
      "import": "./dist/_generated/sdk.gen.js",
      "require": "./dist/_generated/sdk.gen.cjs"
    },
    "./_generated/types.gen": {
      "types": "./dist/_generated/types.gen.d.ts",
      "import": "./dist/_generated/types.gen.js",
      "require": "./dist/_generated/types.gen.cjs"
    },
    "./_generated/client.gen": {
      "types": "./dist/_generated/client.gen.d.ts",
      "import": "./dist/_generated/client.gen.js",
      "require": "./dist/_generated/client.gen.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "tsup && node scripts/verify-exports.mjs --record",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "node scripts/verify-exports.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "undici": "^7.28.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0"
  }
}
